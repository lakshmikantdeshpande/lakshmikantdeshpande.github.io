layout: layouts/base.njk
section: writing
article: true
---
<article class="reading-page"><a class="back-link" href="/writing/">← All writing</a><header class="article-header"><span class="eyebrow">{{ category or 'FIELD NOTES' }}</span><h1>{{ title }}</h1><p>{{ description }}</p><div class="article-meta"><span>{{ site.name }}</span><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time><span>{{ content | readingTime }} min read</span></div></header><div class="prose">{{ content | safe }}</div><footer class="article-footer"><p>Have a thought on this?</p><a class="text-link" href="mailto:{{ site.email }}">I’d love to hear it <span aria-hidden="true">↗</span></a></footer></article>
