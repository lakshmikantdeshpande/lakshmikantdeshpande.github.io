<article class="post-row"><div class="post-date"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><span>{{ post.data.category or 'Notes' }}</span></div><div><{{ postHeading or "h3" }} class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></{{ postHeading or "h3" }}><p>{{ post.data.description }}</p></div><span class="post-arrow" aria-hidden="true">↗</span></article>
