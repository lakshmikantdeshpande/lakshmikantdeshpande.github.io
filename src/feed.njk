---
permalink: /feed.xml
layout: false
sitemap: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
<title>{{ site.name }} — Writing</title><subtitle>Notes on software, practical AI, and things worth building.</subtitle>
<link href="{{ site.url }}/feed.xml" rel="self"/><link href="{{ site.url }}/writing/"/>
<id>{{ site.url }}/writing/</id><updated>{% if collections.posts.length %}{{ collections.posts[0].date | isoDate }}{% else %}2026-10-04T00:00:00.000Z{% endif %}</updated>
<author><name>{{ site.name }}</name><uri>{{ site.url }}/about/</uri></author>
{% for post in collections.posts %}<entry><title>{{ post.data.title }}</title><link href="{{ site.url }}{{ post.url }}"/><id>{{ site.url }}{{ post.url }}</id><updated>{{ post.date | isoDate }}</updated><summary>{{ post.data.description }}</summary></entry>{% endfor %}
</feed>
